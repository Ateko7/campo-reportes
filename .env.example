# Copia a .env para desarrollo local (en Vercel se configuran como Environment Variables)

# Base de datos PostgreSQL (Supabase). Usa la cadena del "Connection Pooler".
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:6543/postgres

# Secreto para firmar la sesión (cámbialo por algo largo y aleatorio)
SESSION_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# URL pública de la app (para enlaces de pago)
APP_URL=https://tu-app.vercel.app

# Empresa por defecto para el webhook de WhatsApp cuando no se identifica el número
EMPRESA_DEFAULT_SLUG=

# --- WhatsApp Cloud API de Meta (oficial) ---
# Webhook: GET/POST  https://TU-APP/webhook/meta
META_VERIFY_TOKEN=inventa-un-texto-secreto   # el mismo que pongas en el panel de Meta
META_ACCESS_TOKEN=                            # token de acceso de tu app de WhatsApp en Meta
# Para separar empresas: guarda el "Phone Number ID" de Meta en el campo
# "Número de WhatsApp entrante" de cada empresa (Configuración -> Marca).

# --- Twilio WhatsApp (alternativa, opcional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Recurrente (cobro de mensualidad) ---
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_PRICE_ID=
RECURRENTE_WEBHOOK_SECRET=
PRECIO_MENSUAL=US$ 29 / mes
